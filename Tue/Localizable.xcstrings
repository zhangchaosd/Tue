        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %#@hosts@"
          },
          "substitutions": {
            "hosts": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg host"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg hosts"
                    }
                  }
                }
              }
            }
          }
        },
